{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["bun", "vite/client"],
    "baseUrl": "../..",
    "paths": {
      "@cashu/coco-core": ["packages/core/index.ts"],
      "@cashu/coco-core/adapter": ["packages/core/adapter.ts"],
      "@cashu/coco-core/plugin": ["packages/core/plugin.ts"],
      "@core/*": ["packages/core/*"]
    }
  },
  "include": ["./**/*.ts"]
}
