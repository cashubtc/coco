            }
          }
        }
      },
      "post": {
        "operationId": "postMints",
        "summary": "Register a Known Mint, optionally setting its trust",
        "security": [{ "clientCredential": [] }],
        "x-cocod-capability": "wallet:admin",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
