    "/v1/balances": {
      "get": {
        "operationId": "getBalances",
        "summary": "Spendable, reserved, and total balances by Mint and unit",
        "security": [{ "clientCredential": [] }],
        "x-cocod-capability": "wallet:read",
        "parameters": [
          {
            "name": "mintUrl",
            "in": "query",
            "required": false,
            "description": "Restrict balances to these Known Mints.",
            "schema": {
              "type": "array",
              "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
            },
            "style": "form",
            "explode": true
          },
          {
            "name": "unit",
            "in": "query",
            "required": false,
            "description": "Restrict balances to these units.",
            "schema": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "style": "form",
            "explode": true
          },
          {
            "name": "trustedOnly",
            "in": "query",
            "required": false,
            "description": "Restrict balances to trusted Known Mints.",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Balances" } }
            }
          },
          "default": {
            "description": "Error document; `error.code` is stable interface data.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
