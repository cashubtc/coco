    "/v1/history": {
      "get": {
        "operationId": "getHistory",
        "summary": "List Wallet history, newest first",
        "security": [{ "clientCredential": [] }],
        "x-cocod-capability": "wallet:read",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
