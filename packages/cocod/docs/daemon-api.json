{
  "name": "cocod-daemon-api",
  "version": "0.0.17",
  "transport": {
    "protocol": "http",
    "unixSocketEnv": "COCOD_SOCKET",
    "defaultUnixSocket": "~/.cocod/cocod.sock"
  },
  "responseContract": {
    "success": {
      "shape": {
        "output": "unknown"
      }
    },
    "error": {
      "shape": {
        "error": "string"
      }
    }
  },
  "endpoints": [
    {
      "path": "/ping",
      "method": "GET",
      "state": "any",
      "responses": {
        "200": "{ output: \"pong\" }"
      }
    },
    {
      "path": "/status",
      "method": "GET",
      "state": "any",
      "responses": {
        "200": "{ output: \"UNINITIALIZED\" | \"LOCKED\" | \"STARTING\" | \"UNLOCKED\" | \"STOPPING\" | \"ERROR\" }"
      }
    },
    {
      "path": "/init",
      "method": "POST",
      "state": "UNINITIALIZED",
      "body": {
        "mnemonic": "string (optional)",
        "passphrase": "string (optional)",
        "mintUrl": "string (optional)"
      },
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: \"Invalid mnemonic\" }",
        "409": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/unlock",
      "method": "POST",
      "state": "LOCKED",
      "body": {
        "passphrase": "string"
      },
      "responses": {
        "200": "{ output: \"Unlocked\" }",
        "400": "{ error: string }",
        "401": "{ error: string }",
        "409": "{ error: string }",
        "503": "{ error: string }"
      }
    },
    {
      "path": "/balance",
      "method": "GET",
      "state": "UNLOCKED",
      "notes": "sats is the total balance (spendable + reserved), matching pre-v2 semantics; sat unit only. Mints with no proofs are omitted.",
      "responses": {
        "200": "{ output: Record<string, { sats: number }> }",
        "403": "{ error: string }",
        "503": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/receive/cashu",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "token": "string"
      },
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/receive/bolt11",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "amount": "number",
        "mintUrl": "string (optional)"
      },
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/receive/bolt12",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "amount": "number (optional, positive integer sats; embedded in the offer)",
        "mintUrl": "string (optional)"
      },
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      },
      "notes": "NUT-25 BOLT12 mint quote. The returned offer is reusable and stays payable after it is paid. Payments are claimed in the background and show up in /history."
    },
    {
      "path": "/receive/bolt12/list",
      "method": "GET",
      "state": "UNLOCKED",
      "responses": {
        "200": "{ output: Array<{ quoteId, mintUrl, request, amount?, paid, issued, expiry }> }",
        "500": "{ error: string }"
      },
      "notes": "Offers that are still payable. `paid` is what the mint has received against the offer and `issued` is what this wallet has already claimed from it; the difference is claimed in the background."
    },
    {
      "path": "/send/cashu",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "amount": "number",
        "mintUrl": "string (optional)"
      },
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/send/bolt11",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "invoice": "string",
        "mintUrl": "string (optional)"
      },
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/send/bolt12",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "offer": "string",
        "amount": "number (optional, positive integer sats; required by the mint for offers without a fixed amount)",
        "mintUrl": "string (optional)"
      },
      "responses": {
        "200": "{ output: string }",
        "202": "{ output: string }",
        "400": "{ error: string }",
        "500": "{ error: string }"
      },
      "notes": "NUT-25 BOLT12 melt. The mint's fee reserve is spent on top of the amount. A 202 means the mint has not settled the payment: it is not confirmed, must not be retried, and carries the operation id."
    },
    {
      "path": "/x-cashu/parse",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "request": "string"
      },
      "notes": "Accepts creqA and creqB. NUT-10 spending conditions are resolved by Coco during parse.",
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/x-cashu/handle",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "request": "string",
        "mintUrl": "string (optional)"
      },
      "notes": "Accepts creqA and creqB. Coco enforces NUT-10 spending conditions: P2PK-locked requests are paid with locked outputs; unsupported or malformed conditions return 400 before proofs are prepared.",
      "responses": {
        "200": "{ output: string }",
        "400": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/mints/add",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "url": "string"
      },
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/mints/list",
      "method": "GET",
      "state": "UNLOCKED",
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/mints/info",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "url": "string"
      },
      "responses": {
        "200": "{ output: unknown }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/history",
      "method": "GET",
      "state": "UNLOCKED",
      "query": {
        "offset": "number (optional, default 0)",
        "limit": "number (optional, default 20, max 100)"
      },
      "responses": {
        "200": "{ output: unknown[] }",
        "400": "{ error: string }"
      }
    },
    {
      "path": "/events",
      "method": "GET",
      "state": "UNLOCKED",
      "responses": {
        "200": "text/event-stream"
      }
    },
    {
      "path": "/npc/address",
      "method": "GET",
      "state": "UNLOCKED",
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/npc/username",
      "method": "POST",
      "state": "UNLOCKED",
      "body": {
        "username": "string",
        "confirm": "boolean (optional)"
      },
      "responses": {
        "200": "{ output: unknown }",
        "400": "{ error: string }",
        "402": "{ error: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/stop",
      "method": "POST",
      "state": "any",
      "responses": {
        "200": "{ output: \"Daemon stopping\" }"
      }
    }
  ]
}
