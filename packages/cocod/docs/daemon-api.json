{
  "name": "cocod-daemon-api",
  "version": "0.0.17",
  "transport": {
    "protocol": "http",
    "network": "tcp",
    "defaultUrl": "http://127.0.0.1:62626",
    "listenHostEnv": "COCOD_LISTEN_HOST",
    "listenPortEnv": "COCOD_LISTEN_PORT",
    "clientUrlEnv": "COCOD_URL"
  },
  "authentication": {
    "scheme": "bearer",
    "publicPaths": ["/health"],
    "protectedPaths": "all legacy routes and every /v1 route",
    "openApiDescription": "openapi-v1.json"
  },
  "responseContract": {
    "scope": "unversioned NPC extension routes",
    "success": {
      "shape": {
        "output": "unknown"
      }
    },
    "error": {
      "shape": {
        "error": "string"
      }
    }
  },
  "endpoints": [
    {
      "path": "/npc/address",
      "method": "GET",
      "state": "cocoSession.running",
      "responses": {
        "200": "{ output: string }",
        "500": "{ error: string }"
      }
    },
    {
      "path": "/npc/username",
      "method": "POST",
      "state": "cocoSession.running",
      "body": {
        "username": "string",
        "confirm": "boolean (optional)"
      },
      "responses": {
        "200": "{ output: unknown }",
        "400": "{ error: string }",
        "402": "{ error: string }",
        "500": "{ error: string }"
      }
    }
  ]
}
