meta {
  name: Trust Known Mint
  type: http
  seq: 3
  tags: [
    mutation
    wallet
  ]
}

post {
  url: {{baseUrl}}/v1/mints/trust
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~Idempotency-Key: {{$guid}}
}

body:json {
  {
    "mintUrl": "{{mintUrl}}"
  }
}

docs {
  Allow Wallet operations through a previously registered Known Mint.

  Implemented v1 contract. Expected success status: 200.
}
