meta {
  name: Prepare Mint Operation
  type: http
  seq: 1
  tags: [
    mutation
    financial
  ]
}

post {
  url: {{baseUrl}}/v1/operations/mint
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~Idempotency-Key: {{$guid}}
}

body:json {
  {
    "mintUrl": "{{mintUrl}}",
    "quoteId": "{{mintQuoteId}}",
    "amount": "{{amount}}"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar('mintOperationId', res.body.id);
}

docs {
  Prepare a durable Mint Operation from a paid Mint Quote.

  Implemented v1 contract. Expected success status: 201.
}
