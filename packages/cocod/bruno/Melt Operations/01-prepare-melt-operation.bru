meta {
  name: Prepare Melt Operation
  type: http
  seq: 1
  tags: [
    mutation
    financial
  ]
}

post {
  url: {{baseUrl}}/v1/operations/melt
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~Idempotency-Key: {{$guid}}
}

body:json {
  {
    "mintUrl": "{{mintUrl}}",
    "quoteId": "{{meltQuoteId}}"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar('meltOperationId', res.body.id);
}

docs {
  Prepare and reserve proofs for a quote-backed Melt Operation.

  Implemented v1 contract. Expected success status: 201.
}
