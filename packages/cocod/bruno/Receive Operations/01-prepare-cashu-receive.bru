meta {
  name: Prepare Cashu Receive
  type: http
  seq: 1
  tags: [
    mutation
    financial
    sensitive
  ]
}

post {
  url: {{baseUrl}}/v1/operations/receive
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~Idempotency-Key: {{$guid}}
}

body:json {
  {
    "token": "{{cashuToken}}"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar('receiveOperationId', res.body.id);
}

docs {
  Prepare a Cashu Receive Operation without executing it.

  Implemented v1 contract. Expected success status: 201.
}
