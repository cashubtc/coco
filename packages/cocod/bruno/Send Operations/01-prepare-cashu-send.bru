meta {
  name: Prepare Cashu Send
  type: http
  seq: 1
  tags: [
    mutation
    financial
  ]
}

post {
  url: {{baseUrl}}/v1/operations/send
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~Idempotency-Key: {{$guid}}
}

body:json {
  {
    "mintUrl": "{{mintUrl}}",
    "amount": "{{amount}}",
    "unit": "{{unit}}",
    "forceSwap": false
  }
}

script:post-response {
  if (res.status === 201) bru.setVar('sendOperationId', res.body.id);
}

docs {
  Prepare a Cashu Send Operation without executing it.

  Implemented v1 contract. Expected success status: 201.
}
